#!/usr/bin/env bash
set -uo pipefail

DRY_RUN=0
FAILURES=0
LOCK_FILE=${SERVER_MAINTENANCE_LOCK_FILE:-/run/lock/server-maintenance.lock}
ROOT_PATH=${SERVER_MAINTENANCE_ROOT_PATH:-/}
declare -a RESULTS=()

log() {
  printf '%s %s\n' "$(date --iso-8601=seconds)" "$*"
}

effective_uid() {
  printf '%s\n' "$EUID"
}

usage() {
  printf 'Usage: %s [--dry-run]\n' "${0##*/}"
}

parse_args() {
  case $# in
    0)
      DRY_RUN=0
      ;;
    1)
      if [[ $1 != --dry-run ]]; then
        usage >&2
        return 2
      fi
      DRY_RUN=1
      ;;
    *)
      usage >&2
      return 2
      ;;
  esac
}

available_bytes() {
  df -B1 --output=avail "$ROOT_PATH" | awk 'NR == 2 { print $1 }'
}

human_bytes() {
  numfmt --to=iec-i --suffix=B "$1" 2>/dev/null || printf '%s bytes\n' "$1"
}

acquire_lock() {
  if ((DRY_RUN)) && [[ $LOCK_FILE == /run/lock/server-maintenance.lock ]] &&
    [[ $(effective_uid) -ne 0 ]]; then
    LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/server-maintenance-dry-run-$EUID.lock"
  fi

  exec 9>"$LOCK_FILE" || return 1
  flock -n 9
}

run_stage() {
  local name=$1
  local rc
  shift

  log "stage=$name status=started"
  if "$@"; then
    RESULTS+=("$name=ok")
    log "stage=$name status=ok"
  else
    rc=$?
    RESULTS+=("$name=failed($rc)")
    FAILURES=$((FAILURES + 1))
    log "stage=$name status=failed rc=$rc" >&2
  fi
}

stage_pacman() {
  if ! command -v paccache >/dev/null; then
    log 'paccache is not installed' >&2
    return 127
  fi

  if ((DRY_RUN)); then
    paccache -dk2
  else
    paccache -rk2
  fi
}

docker_ready() {
  command -v docker >/dev/null && docker info >/dev/null 2>&1
}

stage_docker_images() {
  if ! docker_ready; then
    log 'Docker daemon is unavailable' >&2
    return 1
  fi

  if ((DRY_RUN)); then
    docker system df
    log 'would_run=docker image prune --all --force --filter until=336h'
  else
    docker image prune --all --force --filter until=336h
  fi
}

stage_docker_builder() {
  if ! docker_ready; then
    log 'Docker daemon is unavailable' >&2
    return 1
  fi

  if ((DRY_RUN)); then
    docker system df
    log 'would_run=docker builder prune --all --force --filter until=336h'
  else
    docker builder prune --all --force --filter until=336h
  fi
}

stage_journal() {
  if ! command -v journalctl >/dev/null; then
    log 'journalctl is unavailable' >&2
    return 127
  fi

  if ((DRY_RUN)); then
    journalctl --disk-usage
    log 'would_run=journalctl --vacuum-time=30d --vacuum-size=200M'
  else
    journalctl --vacuum-time=30d --vacuum-size=200M
  fi
}

main() {
  local before after delta

  DRY_RUN=0
  FAILURES=0
  RESULTS=()

  parse_args "$@" || return $?

  if ((!DRY_RUN)) && [[ $(effective_uid) -ne 0 ]]; then
    log 'live maintenance requires root' >&2
    return 1
  fi

  if ! acquire_lock; then
    log "another maintenance run holds $LOCK_FILE" >&2
    return 1
  fi

  before=$(available_bytes) || {
    log 'cannot read initial disk availability' >&2
    return 1
  }
  log "maintenance=start dry_run=$DRY_RUN available_before=$before"

  run_stage pacman stage_pacman
  run_stage docker-images stage_docker_images
  run_stage docker-builder stage_docker_builder
  run_stage journal stage_journal

  after=$(available_bytes) || {
    log 'cannot read final disk availability' >&2
    return 1
  }
  delta=$((after - before))
  log "maintenance=summary results=${RESULTS[*]} available_after=$after delta=$delta human_delta=$(human_bytes "$delta")"

  ((FAILURES == 0))
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
  exit $?
fi
